# ==========================================================================
# Mom's Cloud — cabeceras de Cloudflare Pages
#
# IMPORTANTE: Cloudflare Pages solo procesa _headers si está en la RAÍZ del
# directorio de salida. Mientras esta carpeta viva dentro del repositorio de
# hogarconectado.co (cuyo proyecto de Pages tiene la raíz del repo como salida)
# este archivo es INERTE y no aplica ninguna cabecera.
#
# Se activa solo cuando se cree un proyecto de Cloudflare Pages con
# "Root directory" = moms-cloud/. Entonces todo funciona sin tocar nada.
# ==========================================================================

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  # Todo es de origen propio: fuentes, GSAP, Lenis e imágenes están
  # autohospedados. Por eso la CSP puede ser tan estricta.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# HTML: siempre revalidar
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Assets con nombre estable: cache larga
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800

/site.webmanifest
  Cache-Control: public, max-age=604800
  Content-Type: application/manifest+json
